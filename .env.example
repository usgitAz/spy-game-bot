# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Game defaults (can be overridden per-game from the settings panel)
MIN_PLAYERS=3
MAX_PLAYERS=10
MIN_SPIES=1
MAX_SPIES=2
SPY_THRESHOLD_PLAYERS=7
MIN_ROUND_MINUTES=3
MAX_ROUND_MINUTES=10
LOBBY_TIMEOUT_SECONDS=300
VOTING_TIMEOUT_SECONDS=60
FINAL_GUESS_SECONDS=30
REDIS_GAME_TTL_SECONDS=3600

#throttle
THROTTLE_CALLBACK_SECONDS=0.7
THROTTLE_COMMAND_SECONDS=3.0
# Logging
LOG_LEVEL=INFO


#This variable should only be used when you are running locally and Telegram is filtered/blocked for you
#do not use this on production
#change 12334 and use your Socks5 proxy port
# TELEGRAM_PROXY=http://host.docker.internal:12334

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
# Max size of each rotated file, in megabytes
LOG_MAX_MB=20
LOG_BACKUP_COUNT=3
